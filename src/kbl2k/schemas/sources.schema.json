{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kbl2k:schema:sources",
  "title": "데이터 출처 목록",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "retrieved_at"],
        "properties": {
          "id": {"$ref": "urn:kbl2k:schema:common#/$defs/slug"},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "publisher": {"type": ["string", "null"]},
          "official": {"type": "boolean", "default": false},
          "retrieved_at": {"$ref": "urn:kbl2k:schema:common#/$defs/date"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
