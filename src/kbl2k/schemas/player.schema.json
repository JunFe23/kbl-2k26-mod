{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kbl2k:schema:player",
  "title": "KBL 선수",
  "description": "모르는 값은 반드시 null. 추정값을 넣지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name_ko", "name_en", "team_id", "jersey_number", "position_kbl", "positions",
    "height_cm", "weight_kg", "birth_date", "nationality", "player_type", "verification"
  ],
  "properties": {
    "id": {"$ref": "urn:kbl2k:schema:common#/$defs/slug"},
    "kbl_player_id": {
      "type": ["string", "null"],
      "pattern": "^\\d+$",
      "description": "KBL 선수 번호 (https://www.kbl.or.kr/player/player/{id})"
    },
    "name_ko": {"type": "string", "minLength": 1},
    "name_en": {"type": ["string", "null"], "minLength": 1},
    "team_id": {"$ref": "urn:kbl2k:schema:common#/$defs/slug"},
    "jersey_number": {"type": ["integer", "null"], "minimum": 0, "maximum": 99},
    "position_kbl": {
      "enum": ["G", "F", "C", null],
      "description": "KBL 공식 포지션 (G=가드, F=포워드, C=센터)"
    },
    "positions": {
      "type": "array",
      "items": {"enum": ["PG", "SG", "SF", "PF", "C"]},
      "uniqueItems": true,
      "maxItems": 2,
      "description": "2K26 포지션 [주, 보조]. 모드 설계값으로 직접 입력 (kbl2k positions export/import). 미정이면 빈 배열"
    },
    "roster_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "description": "생략하면 active",
      "properties": {
        "state": {"enum": ["active", "injured", "replacement"]},
        "replaces": {
          "$ref": "urn:kbl2k:schema:common#/$defs/slug",
          "description": "대체 선수일 때, 대체 대상 선수 id"
        },
        "since": {"anyOf": [{"$ref": "urn:kbl2k:schema:common#/$defs/date"}, {"type": "null"}]},
        "expected_return": {
          "anyOf": [{"$ref": "urn:kbl2k:schema:common#/$defs/date"}, {"type": "null"}]
        },
        "note": {"type": "string"}
      },
      "if": {"properties": {"state": {"const": "replacement"}}},
      "then": {"required": ["replaces"]},
      "else": {"not": {"required": ["replaces"]}}
    },
    "height_cm": {"type": ["number", "null"], "minimum": 150, "maximum": 240},
    "weight_kg": {"type": ["number", "null"], "minimum": 50, "maximum": 180},
    "birth_date": {"anyOf": [{"$ref": "urn:kbl2k:schema:common#/$defs/date"}, {"type": "null"}]},
    "nationality": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2"
    },
    "player_type": {"enum": ["domestic", "foreign", "asian_quota", null]},
    "stats": {
      "type": "array",
      "items": {"$ref": "urn:kbl2k:schema:common#/$defs/stat_line"},
      "description": "시즌·리그별 경기당 기록 (KBL 및 해외 리그)"
    },
    "rating_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["season", "league"],
      "description": "능력치 산정에 쓸 기록을 직접 지정 (생략 시 자동 선택)",
      "properties": {
        "season": {"$ref": "urn:kbl2k:schema:common#/$defs/season"},
        "league": {"type": "string", "minLength": 1},
        "reason": {"type": "string"}
      }
    },
    "ratings_override": {
      "type": "object",
      "propertyNames": {"$ref": "urn:kbl2k:schema:attributes#/$defs/attribute_name"},
      "additionalProperties": {"$ref": "urn:kbl2k:schema:attributes#/$defs/rating"},
      "description": "수동 보정값. 산정 결과보다 우선"
    },
    "verification": {"$ref": "urn:kbl2k:schema:common#/$defs/verification"},
    "notes": {"type": "string"}
  }
}
